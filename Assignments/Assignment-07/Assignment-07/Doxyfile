PROJECT_NAME           = "Calculator and Logger"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "A simple C++ calculator with logging"

OUTPUT_DIRECTORY       = docs

INPUT                  = Logger.h CalculationEngine.h main.cpp
FILE_PATTERNS           = *.h *.cpp
RECURSIVE              = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_TIMESTAMP         = YES
GENERATE_TREEVIEW      = YES

GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
USE_PDFLATEX           = YES

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

